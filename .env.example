# LINE Messaging API（在 LINE Developers Console 的 Channel 頁面取得）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 伺服器埠號
PORT=3000

# 定時對話摘要的 cron 表達式（預設每天晚上 21:00）
# 格式: 分 時 日 月 星期
SUMMARY_CRON=0 21 * * *

# 每日晨間建築與營造新聞推播 cron（預設每天早上 08:00）
CONSTRUCTION_NEWS_CRON=0 8 * * *

# 預設新對話是否自動開啟晨間新聞推播（true / false，預設 false，避免打擾每個人，由使用者自由「開啟新聞」）
DEFAULT_NEWS_ENABLED=false

# 預設新對話是否自動開啟晚間對話總結（true / false，預設 true，有新訊息時才推播）
DEFAULT_SUMMARY_ENABLED=true

# 新聞指定推播對象 ID（選填，支援使用者ID或群組ID，多筆以逗號分隔；若留空則依使用者訂閱設定推播）
# NEWS_PUSH_TARGET=U1234567890abcdef,C1234567890abcdef

# 單次摘要最多帶入的訊息則數（避免一次塞太多內容給 OpenAI）
MAX_MESSAGES_PER_SUMMARY=300

# Upstash Redis（免費，用來持久化儲存訊息，不受伺服器重啟影響）
# 在 https://console.upstash.com 建立資料庫後於 REST API 區塊取得
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 外部排程服務（如 GitHub Actions）呼叫 /tasks/summary 時要帶的密鑰
# 本機開發留空即可直接呼叫；正式環境建議設定，避免端點被任意觸發
SUMMARY_TRIGGER_SECRET=

# 使用者傳送這個關鍵字時，會立即整理並回覆目前累積的摘要（不用等排程）
SUMMARY_KEYWORD=摘要

# --- 以下僅供 scripts/sync-to-mysql.js 使用（在NAS/內網主機上執行，不會用在Render） ---
# NAS上的MySQL/MariaDB連線資訊
MYSQL_HOST=192.168.0.20
MYSQL_PORT=13306
MYSQL_USER=linechat_sync
MYSQL_PASSWORD=
MYSQL_DATABASE=linechat_archive
